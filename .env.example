DISCORD_BOT_TOKEN=dat-token-bot-cua-ban-o-day
OPENAI_API_KEY=dat-openrouter-key-cua-ban-o-day
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter tự chọn model free còn khả dụng.
OPENAI_MODEL=openrouter/free
# Hoặc nhập danh sách model, cách nhau bằng dấu phẩy, để tự fallback theo thứ tự.
# OPENROUTER_MODELS=model-a:free,model-b:free,openrouter/free
ALLOW_PROFANITY=true
REPLY_COOLDOWN_MS=8000
RANDOM_REACTION_CHANCE=0.12
